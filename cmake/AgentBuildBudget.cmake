# Ninja job pools that keep parallel builds inside this machine's memory and CPU budget
# (docs/design/adr/0003-build-budget.md). Included from CMakeLists.txt, it sizes the pools at
# configure time; `cmake -P cmake/AgentBuildBudget.cmake` (`make jobs`) prints the budget.
#
#   pool     used by                                       memory per job  cores
#   compile  every ordinary C++ translation unit           2 GB            all usable
#   link     every link step                               4 GB            half
#   heavy    targets declared HEAVY or CUDA in agent_cc_*  12 GB           half
#
# Memory is MemAvailable less 20 percent of the total, capped by the cgroup v2 memory.max of
# this process's cgroup and its ancestors. Cores are the CPU affinity mask capped by cgroup
# cpu.max, less two kept for the desktop, the agent and the test runner. The environment
# variable AGENT_MAX_JOBS lowers every pool; nothing raises one. AGENT_BUDGET_ROOT prefixes the
# /proc and /sys paths so tests can supply fixture files.
if(CMAKE_SCRIPT_MODE_FILE)
  cmake_minimum_required(VERSION 3.28) # Script mode starts without policies.
endif()
include_guard(GLOBAL)

# The first line of `path` when it is a non-negative integer, else "" (cgroup writes "max").
function(_agent_budget_number path out)
  set(value "")
  if(EXISTS "${path}")
    file(STRINGS "${path}" lines LIMIT_COUNT 1)
    if(lines MATCHES "^([0-9]+)$")
      set(value "${CMAKE_MATCH_1}")
    endif()
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Jobs of one pool: what fits in `usable` MiB at `job_mib` each (a remainder of at least 80
# percent of a job counts as one more) and in the pool's share of `cpus`; at least one.
function(_agent_budget_pool usable cpus job_mib divisor out)
  math(EXPR mem "${usable} / ${job_mib}")
  math(EXPR rem "${usable} % ${job_mib}")
  if(rem GREATER 0)
    math(EXPR rem10 "${rem} * 10")
    math(EXPR job8 "${job_mib} * 8")
    if(rem10 GREATER_EQUAL job8)
      math(EXPR mem "${mem} + 1")
    endif()
  endif()
  math(EXPR cpu "(${cpus} - 2) / ${divisor}")
  set(jobs ${mem})
  if(cpu LESS jobs)
    set(jobs ${cpu})
  endif()
  if(jobs LESS 1)
    set(jobs 1)
  endif()
  set(${out} ${jobs} PARENT_SCOPE)
endfunction()

# Tenths of a GiB from MiB, for the summary: 81920 -> 80.0G.
function(_agent_budget_gib mib out)
  math(EXPR tenths "${mib} * 10 / 1024")
  math(EXPR whole "${tenths} / 10")
  math(EXPR frac "${tenths} % 10")
  set(${out} "${whole}.${frac}G" PARENT_SCOPE)
endfunction()

# Sets AGENT_COMPILE_JOBS, AGENT_LINK_JOBS, AGENT_HEAVY_JOBS and AGENT_BUDGET_SUMMARY.
function(agent_build_budget)
  set(root "${AGENT_BUDGET_ROOT}")
  if(NOT root)
    set(root "$ENV{AGENT_BUDGET_ROOT}")
  endif()

  # Host memory in MiB; 8 GiB total and 4 GiB available when /proc/meminfo is unreadable.
  set(total 8192)
  set(avail 4096)
  if(EXISTS "${root}/proc/meminfo")
    file(STRINGS "${root}/proc/meminfo" meminfo REGEX "^Mem(Total|Available):")
    foreach(line IN LISTS meminfo)
      if(line MATCHES "^MemTotal: +([0-9]+) kB")
        math(EXPR total "${CMAKE_MATCH_1} / 1024")
      elseif(line MATCHES "^MemAvailable: +([0-9]+) kB")
        math(EXPR avail "${CMAKE_MATCH_1} / 1024")
      endif()
    endforeach()
  endif()

  # CPUs in the affinity mask, e.g. "0-3,8-11"; the host count when it is unreadable.
  set(cpus 0)
  if(EXISTS "${root}/proc/self/status")
    file(STRINGS "${root}/proc/self/status" status REGEX "^Cpus_allowed_list:")
    string(REGEX REPLACE "^Cpus_allowed_list:[ \t]*" "" ranges "${status}")
    string(REPLACE "," ";" ranges "${ranges}")
    foreach(range IN LISTS ranges)
      if(range MATCHES "^([0-9]+)-([0-9]+)$")
        math(EXPR cpus "${cpus} + ${CMAKE_MATCH_2} - ${CMAKE_MATCH_1} + 1")
      elseif(range MATCHES "^[0-9]+$")
        math(EXPR cpus "${cpus} + 1")
      endif()
    endforeach()
  endif()
  if(cpus LESS 1)
    cmake_host_system_information(RESULT cpus QUERY NUMBER_OF_LOGICAL_CORES)
  endif()

  # cgroup v2 limits of this process's cgroup and every ancestor; the tightest one wins.
  set(cgroot "${root}/sys/fs/cgroup")
  set(path "")
  if(EXISTS "${root}/proc/self/cgroup")
    file(STRINGS "${root}/proc/self/cgroup" cgroup REGEX "^0::")
    string(REGEX REPLACE "^0::" "" path "${cgroup}")
  endif()
  string(REGEX REPLACE "/+$" "" dir "${cgroot}${path}")
  while(TRUE)
    _agent_budget_number("${dir}/memory.max" limit)
    if(limit)
      _agent_budget_number("${dir}/memory.current" usage)
      if(NOT usage)
        set(usage 0)
      endif()
      math(EXPR limit_mib "${limit} / 1048576")
      math(EXPR head_mib "(${limit} - ${usage}) / 1048576")
      if(head_mib LESS 0)
        set(head_mib 0)
      endif()
      if(limit_mib LESS total)
        set(total ${limit_mib})
      endif()
      if(head_mib LESS avail)
        set(avail ${head_mib})
      endif()
    endif()
    if(EXISTS "${dir}/cpu.max")
      file(STRINGS "${dir}/cpu.max" quota LIMIT_COUNT 1)
      if(quota MATCHES "^([0-9]+) ([0-9]+)$" AND CMAKE_MATCH_2 GREATER 0)
        math(EXPR quota_cpus "(${CMAKE_MATCH_1} + ${CMAKE_MATCH_2} - 1) / ${CMAKE_MATCH_2}")
        if(quota_cpus LESS 1)
          set(quota_cpus 1)
        endif()
        if(quota_cpus LESS cpus)
          set(cpus ${quota_cpus})
        endif()
      endif()
    endif()
    if(dir STREQUAL cgroot OR NOT dir MATCHES "^${cgroot}/")
      break()
    endif()
    get_filename_component(dir "${dir}" DIRECTORY)
  endwhile()

  math(EXPR usable "${avail} - ${total} * 20 / 100")
  if(usable LESS 0)
    set(usable 0)
  endif()
  _agent_budget_pool(${usable} ${cpus} 2048 1 compile)
  _agent_budget_pool(${usable} ${cpus} 4096 2 link)
  _agent_budget_pool(${usable} ${cpus} 12288 2 heavy)

  set(cap "$ENV{AGENT_MAX_JOBS}")
  if(cap MATCHES "^[0-9]+$" AND cap GREATER 0)
    foreach(pool compile link heavy)
      if(${pool} GREATER cap)
        set(${pool} ${cap})
      endif()
    endforeach()
  endif()

  _agent_budget_gib(${total} total_text)
  _agent_budget_gib(${avail} avail_text)
  _agent_budget_gib(${usable} usable_text)
  set(AGENT_COMPILE_JOBS ${compile} PARENT_SCOPE)
  set(AGENT_LINK_JOBS ${link} PARENT_SCOPE)
  set(AGENT_HEAVY_JOBS ${heavy} PARENT_SCOPE)
  string(CONCAT summary "compile=${compile} link=${link} heavy=${heavy} (cpus=${cpus}, "
         "memory total=${total_text} available=${avail_text} usable=${usable_text})")
  set(AGENT_BUDGET_SUMMARY "${summary}" PARENT_SCOPE)
endfunction()

agent_build_budget()
if(CMAKE_SCRIPT_MODE_FILE)
  message(NOTICE "${AGENT_BUDGET_SUMMARY}")
  return()
endif()

set(AGENT_HEAVY_POOL "")
if(CMAKE_GENERATOR MATCHES "Ninja")
  set_property(GLOBAL PROPERTY JOB_POOLS compile=${AGENT_COMPILE_JOBS} link=${AGENT_LINK_JOBS}
                                         heavy=${AGENT_HEAVY_JOBS})
  set(CMAKE_JOB_POOL_COMPILE compile)
  set(CMAKE_JOB_POOL_LINK link)
  set(AGENT_HEAVY_POOL heavy)
  message(STATUS "agent: build budget ${AGENT_BUDGET_SUMMARY}")
else()
  message(STATUS "agent: job pools need the Ninja generator; the build budget is not applied")
endif()

if(AGENT_CCACHE)
  find_program(AGENT_CCACHE_PROGRAM ccache)
  if(AGENT_CCACHE_PROGRAM)
    set(CMAKE_CXX_COMPILER_LAUNCHER "${AGENT_CCACHE_PROGRAM}")
    set(CMAKE_CUDA_COMPILER_LAUNCHER "${AGENT_CCACHE_PROGRAM}")
  endif()
endif()
